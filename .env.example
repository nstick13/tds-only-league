# Copy this file to .env.local and fill in real values from your Supabase
# project. Never commit .env.local.
#
# These same three variables must also be set in your Vercel project
# (Settings > Environment Variables), ticked for EVERY environment you
# deploy — Production, Preview and Development.
#
# Two gotchas that have bitten this project before:
#   1. The NEXT_PUBLIC_* values are compiled into the build. Editing them in
#      Vercel does nothing until you REDEPLOY (with the build cache off).
#   2. Check the variable NAME as carefully as the value. A misnamed
#      variable is indistinguishable from a missing one at runtime — see
#      src/lib/supabase/env.ts, which now names the offender for you.

# Supabase project URL (Project Settings > Data API > Project URL). Safe to
# expose to the browser — used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (Project Settings > API Keys). Safe to
# expose to the browser — Row Level Security policies are what actually
# protect the data, not secrecy of this key. Either the legacy `anon` JWT
# (eyJhbGci...) or a modern publishable key (sb_publishable_...) works.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Supabase service-role key (Project Settings > API Keys > secret keys).
# Modern projects issue these as `sb_secret_...`; older ones have a legacy
# service_role JWT. Either works — paste it as ONE UNBROKEN LINE, since a
# wrapped paste produces whitespace that makes an invalid HTTP header.
#
# SERVER-ONLY. Bypasses Row Level Security entirely — never prefix with
# NEXT_PUBLIC_, never import into client components, never log it. Used by
# trusted server code (the commissioner's manual sync triggers) to invoke
# the Tank01 sync Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOTE: the Edge Functions themselves read RAPIDAPI_KEY, SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY from SUPABASE's own secrets (Edge Functions >
# Secrets), not from this file. Supabase injects the latter two itself.
